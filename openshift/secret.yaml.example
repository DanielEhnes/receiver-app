# Copy to secret.yaml, fill in, then: oc apply -f openshift/secret.yaml
# (secret.yaml is git-ignored.) Or create it directly:
#   oc create secret generic receiver-app-secret \
#     --from-literal=S3_ACCESS_KEY_ID=... --from-literal=S3_SECRET_ACCESS_KEY=... \
#     --from-literal=APP_USERNAME=... --from-literal=APP_PASSWORD=...
apiVersion: v1
kind: Secret
metadata:
  name: receiver-app-secret
  labels:
    app: receiver-app
type: Opaque
stringData:
  S3_ACCESS_KEY_ID: ""
  S3_SECRET_ACCESS_KEY: ""
  APP_USERNAME: ""
  APP_PASSWORD: ""
