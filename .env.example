# --- S3 (non-secret; ConfigMap in OpenShift) ---
S3_ENDPOINT_URL=https://s3.example.internal:9000
S3_BUCKET=receiver
S3_REGION=us-east-1
S3_ROOT_PREFIX=upload/
# Optional: path to a CA certificate for an S3 endpoint with a private CA
S3_CA_BUNDLE=
# Set to false only for testing against self-signed endpoints
S3_VERIFY_SSL=true
# Create the bucket on startup if it does not exist
S3_CREATE_BUCKET=false
# Reject zips whose total uncompressed size exceeds this (bytes; default 1 GiB)
MAX_UNZIPPED_BYTES=1073741824

# --- Secrets (Secret in OpenShift) ---
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
APP_USERNAME=
APP_PASSWORD=
